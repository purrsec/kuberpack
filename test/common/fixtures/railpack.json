{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": [
        "python -m venv --without-pip /app/.venv",
        {"src": "requirements.txt", "dest": "requirements.txt"},
        "python -m pip --python /app/.venv install -r requirements.txt",
        {"path": "/app/.venv/bin"}
      ]
    }
  },
  "deploy": {
    "inputs": [
      {
        "step": "packages:mise",
        "include": ["/mise/shims", "/mise/installs", "/usr/local/bin/mise", "/etc/mise/config.toml", "/root/.local/state/mise"],
        "exclude": ["**/site-packages/pip", "**/site-packages/pip-*.dist-info", "**/ensurepip"]
      },
      {"step": "build", "include": ["/app/.venv"]},
      {"step": "build", "include": ["."], "exclude": [".venv"]}
    ]
  }
}
