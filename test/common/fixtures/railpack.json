{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": [
        "python -m pip install --upgrade pip==26.2.2 certifi==2026.10.23",
        "..."
      ]
    }
  },
  "deploy": {
    "inputs": [
      {
        "step": "build",
        "include": ["/mise/shims", "/mise/installs", "/usr/local/bin/mise", "/etc/mise/config.toml", "/root/.local/state/mise"]
      },
      {"step": "build", "include": ["/app/.venv"]},
      {"step": "build", "include": ["."], "exclude": [".venv"]}
    ]
  }
}
